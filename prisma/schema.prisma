// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Declare schemas here
model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  fullName    String
  firstName   String?
  lastName    String?
  phoneNumber String?
  country     String?
  aboutYou    String?  @db.Text
  role        UserRole @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  fileUploads FileUpload[]
  
  @@map("users")
}

model FileUpload {
  id          Int           @id @default(autoincrement())
  filename    String
  originalName String
  filePath    String?
  fileUrl     String?
  status      ProcessStatus @default(PENDING)
  uploadedBy  Int
  processedAt DateTime?
  errorMessage String?      @db.Text
  recordsProcessed Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations
  user        User          @relation(fields: [uploadedBy], references: [id])
  productData ProductData[] // One file can have many products
  personData  PersonData[]    // One file can have many users  
  salesData   SalesData[]   // One file can have many sales
  
  @@map("file_uploads")
}

enum ProcessStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

model ProductData {
  id          Int      @id @default(autoincrement())
  name        String
  category    String?
  price       Decimal?
  quantity    Int?
  description String?  @db.Text
  sku         String?
  
  // Relation ke file upload
  fileUploadId Int
  fileUpload   FileUpload @relation(fields: [fileUploadId], references: [id])
  
  // Audit fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("product_data")
}

model PersonData {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String
  phone       String?
  address     String?  @db.Text
  dateOfBirth DateTime?
  department  String?
  
  fileUploadId Int
  fileUpload   FileUpload @relation(fields: [fileUploadId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("user_data")
}

model SalesData {
  id          Int      @id @default(autoincrement())
  productName String
  customerName String
  quantity    Int
  unitPrice   Decimal
  totalAmount Decimal
  saleDate    DateTime
  region      String?
  
  fileUploadId Int
  fileUpload   FileUpload @relation(fields: [fileUploadId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("sales_data")
}